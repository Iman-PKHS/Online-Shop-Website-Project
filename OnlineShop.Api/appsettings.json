{
  "ConnectionStrings":
  {
    "DefaultConnection": "Data Source=onlineshop.db"
  },

  "Logging":
  {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Jwt":
  {
    "Issuer": "OnlineShop.Api",
    "Audience": "OnlineShop.Client",
    "ExpiryDays": 7
  },

  "AllowedHosts": "*",

  "Checkout":
  {
    "ReservationHours": 72,
    "ExpiryCheckMinutes": 1
  }
}